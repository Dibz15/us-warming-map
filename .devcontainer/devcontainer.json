{
  "name": "county-warming-map",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install && pip install -r data-pipeline/requirements.txt --break-system-packages",
  "customizations": {
    "vscode": {
      "extensions": [
        "saoudrizwan.claude-dev",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "saoudrizwan.claude-dev@4.0.8"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    {
      "source": "cline-globalstorage",
      "target": "/home/vscode/.vscode-server/data/User/globalStorage/saoudrizwan.claude-dev",
      "type": "volume"
    }
  ]
}
